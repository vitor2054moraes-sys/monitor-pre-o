# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).
# Para carregar no terminal (Linux/macOS):  set -a; . ./.env; set +a

# Obrigatória para a versão de terminal (ou rode "ant auth login" e deixe em branco)
ANTHROPIC_API_KEY=

# Opcional: alertas por e-mail. No Gmail, use uma "senha de app", nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Opcional: onde guardar histórico, favoritos e alertas (padrão: ~/.garimpo.json)
GARIMPO_DADOS=
